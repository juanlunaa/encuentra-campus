# ==============================================================================
# Encuentra Campus — Variables de entorno (plantilla sin secretos)
# Copia este archivo como `.env.local` y completa con tus credenciales reales.
# ==============================================================================

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=encuentra_campus

# --- Autenticación JWT (generar cadena aleatoria segura de al menos 32 caracteres) ---
JWT_SECRET=reemplaza-con-un-secreto-largo-y-aleatorio-de-minimo-32-caracteres

# --- Almacenamiento de imágenes compatible con S3 (AWS S3 / Cloudflare R2) ---
S3_ENDPOINT=https://<tu-account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=encuentra-campus-media
S3_ACCESS_KEY_ID=<tu-access-key-id>
S3_SECRET_ACCESS_KEY=<tu-secret-access-key>
S3_PUBLIC_BASE_URL=https://<tu-dominio-publico-o-r2-dev>
